{
  "name": "bolao-ios-wrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Wrapper iOS (Capacitor) para o Bolao Futebol 2026",
  "scripts": {
    "cap:doctor": "npx cap doctor",
    "cap:sync": "npx cap sync",
    "cap:add:ios": "npx cap add ios",
    "cap:open:ios": "npx cap open ios",
    "ios:prepare": "npm install && npm run cap:add:ios && npm run cap:sync",
    "ios:open": "npm run cap:open:ios"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0"
  }
}
